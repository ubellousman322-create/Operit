<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 内置后与宿主同包，已不需要跨包查询；保留这行只为广播退路仍可寻址。 -->
    <queries><package android:name="com.ai.assistance.operit" /></queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application>
        <activity android:name="com.huigu.phone10.mobile.MainActivity" android:exported="false" />
        <service
            android:name="com.huigu.phone10.mobile.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
        <provider
            android:name="com.huigu.phone10.mobile.OperitProvider"
            android:authorities="com.ai.assistance.operit.mobilevoice"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
