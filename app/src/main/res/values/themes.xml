<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Operit" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Declare support for drawing into the status bar / display cutout area. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Customize your theme here. -->
        
        <!-- splash: night and moon -->
        <item name="android:windowSplashScreenBackground">#2A3440</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_moon_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>
</resources>
